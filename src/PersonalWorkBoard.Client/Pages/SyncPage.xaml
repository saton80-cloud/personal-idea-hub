<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PersonalWorkBoard.Client.Pages.SyncPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             Title="同步中心">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='34,28', Phone='18,20'}" Spacing="20" MaximumWidthRequest="1040" HorizontalOptions="Center">
            <Label Text="设备同步中心" Style="{StaticResource PageTitle}" />
            <Label Text="服务器是唯一权威数据源；PC与手机保留离线副本，恢复局域网后自动增量同步。" Style="{StaticResource Muted}" />
            <Grid ColumnDefinitions="{OnIdiom Desktop='1.1*,.9*', Phone='*'}" RowDefinitions="{OnIdiom Desktop='*', Phone='Auto,Auto'}" ColumnSpacing="18" RowSpacing="18">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="当前连接" Style="{StaticResource SectionTitle}" />
                        <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" Padding="18"><Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape><VerticalStackLayout Spacing="5"><Label Text="局域网服务器" TextColor="#9BB6D8" FontSize="12" /><Label Text="{Binding ServerUrl}" TextColor="White" FontSize="17" FontAttributes="Bold" LineBreakMode="CharacterWrap" /></VerticalStackLayout></Border>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="同步异常" Style="{StaticResource Muted}" /><Label Grid.Column="1" Text="{Binding ConflictCount}" TextColor="{StaticResource Danger}" FontAttributes="Bold" /></Grid>
                        <Button Text="立即双向同步" Command="{Binding SyncNowCommand}" IsEnabled="{Binding HasSession}" />
                        <Label Text="{Binding Status}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="{OnIdiom Desktop=1, Phone=0}" Grid.Row="{OnIdiom Desktop=0, Phone=1}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="连接Android手机" Style="{StaticResource SectionTitle}" />
                        <Label Text="离线使用不需要服务器；需要汇总数据时，由PC生成一次性二维码，手机扫描后先上传本地记录，再下载最新状态。" Style="{StaticResource Muted}" />
                        <Button Text="生成5分钟配对二维码" Command="{Binding GenerateQrCommand}" IsVisible="{Binding IsWindows}" />
                        <Button Text="扫描PC端二维码" Clicked="OnScanClicked" IsVisible="{Binding IsAndroid}" />
                        <Border IsVisible="{Binding IsWindows}" BackgroundColor="White" Stroke="{StaticResource Border}" Padding="14" HorizontalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <zxing:BarcodeGeneratorView Value="{Binding QrPayload}" Format="QrCode" WidthRequest="270" HeightRequest="270" ForegroundColor="#0B1F3A" />
                        </Border>
                        <Label Text="二维码不包含密码，过期或使用一次后立即失效。" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
